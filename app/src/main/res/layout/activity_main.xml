<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cream_bg"
    tools:context=".ui.MainActivity">

    <!-- Top App Bar (64dp height) -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/top_app_bar"
        android:layout_width="0dp"
        android:layout_height="64dp"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Left Mini Sunrise Emblem (44dp x 44dp) -->
        <ImageView
            android:id="@+id/iv_top_logo"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:src="@drawable/ic_arise_badge_small"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:ignore="ContentDescription" />

        <!-- Right User Profile Avatar (48dp x 48dp) -->
        <ImageView
            android:id="@+id/iv_top_avatar"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/placeholder_avatar"
            android:clickable="true"
            android:focusable="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:ignore="ContentDescription" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Main Rounded Content Sheet (#FDFBF7, 32dp top corners, 16dp horizontal margin) -->
    <FrameLayout
        android:id="@+id/main_sheet_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/shape_top_rounded_sheet"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/top_app_bar">

        <!-- Fragment Container -->
        <FrameLayout
            android:id="@+id/fragment_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginBottom="68dp" />
    </FrameLayout>

    <!-- Custom Bottom Navigation Bar (68dp height, #FCECD7 fill) -->
    <LinearLayout
        android:id="@+id/bottom_navigation_bar"
        android:layout_width="0dp"
        android:layout_height="68dp"
        android:background="@color/bottom_nav_fill"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <!-- Tab 1: HOME -->
        <LinearLayout
            android:id="@+id/tab_home"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/iv_nav_home"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:src="@drawable/ic_home_outline"
                tools:ignore="ContentDescription" />

            <TextView
                android:id="@+id/tv_nav_home"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="sans-serif-medium"
                android:text="@string/nav_home"
                android:textColor="@color/text_primary"
                android:textSize="10sp"
                tools:ignore="SmallSp" />
        </LinearLayout>

        <!-- Tab 2: HABITS -->
        <LinearLayout
            android:id="@+id/tab_habits"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/iv_nav_habits"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:src="@drawable/ic_clipboard_outline"
                tools:ignore="ContentDescription" />

            <TextView
                android:id="@+id/tv_nav_habits"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="sans-serif-medium"
                android:text="@string/nav_habits"
                android:textColor="@color/text_primary"
                android:textSize="10sp"
                android:visibility="gone"
                tools:ignore="SmallSp" />
        </LinearLayout>

        <!-- Spacer for Center FAB -->
        <View
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.2" />

        <!-- Tab 3: STATS -->
        <LinearLayout
            android:id="@+id/tab_stats"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/iv_nav_stats"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:src="@drawable/ic_chart_outline"
                tools:ignore="ContentDescription" />

            <TextView
                android:id="@+id/tv_nav_stats"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="sans-serif-medium"
                android:text="@string/nav_stats"
                android:textColor="@color/text_primary"
                android:textSize="10sp"
                android:visibility="gone"
                tools:ignore="SmallSp" />
        </LinearLayout>

        <!-- Tab 4: PROFILE -->
        <LinearLayout
            android:id="@+id/tab_profile"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/iv_nav_profile"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:src="@drawable/ic_user_outline"
                tools:ignore="ContentDescription" />

            <TextView
                android:id="@+id/tv_nav_profile"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="sans-serif-medium"
                android:text="@string/nav_profile"
                android:textColor="@color/text_primary"
                android:textSize="10sp"
                android:visibility="gone"
                tools:ignore="SmallSp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Center Overlapping FAB (+) (62dp x 62dp circle #FAD8B0) -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fab_add_habit"
        android:layout_width="62dp"
        android:layout_height="62dp"
        android:layout_marginBottom="28dp"
        android:contentDescription="@string/add_habit"
        android:src="@drawable/ic_plus"
        app:backgroundTint="@color/peach_accent"
        app:elevation="4dp"
        app:fabCustomSize="62dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:maxImageSize="26dp"
        app:tint="@color/text_primary" />

</androidx.constraintlayout.widget.ConstraintLayout>
